{
    "compilerOptions": {
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "noImplicitAny": true,
        "noUnusedParameters": true,
        "noUnusedLocals": true,
        "strict": true,
        /* CRITICAL ADDS START */
        "skipLibCheck": true,           // 1. Stops TS from looking inside node_modules configs
        "moduleResolution": "node",     // 2. Helps TS find Swiper and Motion correctly
        "target": "ESNext",             // 3. Modernized from 'es5' for better React performance
        /* CRITICAL ADDS END */
        "jsx": "react",
        "baseUrl": "./src",
        "typeRoots": ["./node_modules/@types", "./types"],
        "paths": {
            "~*": ["./*"],
            "react-easy-swipe": ["./types/react-easy-swipe.d.ts"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx"],                 // Include all TypeScript files
    "exclude": ["node_modules", "dist"] // Ensure 'dist' or 'build' is also ignored
}